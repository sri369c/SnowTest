{
  "name": "snowtest",
  "version": "1.0.0",
  "description": "A Snowflake-compatible stub server for testing systems that expect a real Snowflake account.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "snowtest": "./dist/cli.js"
  },
  "main": "./dist/server.js",
  "exports": {
    ".": "./dist/server.js"
  },
  "scripts": {
    "dev": "tsx watch src/cli.ts",
    "start": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:py": "bash tests/compat/run.sh",
    "test:dbt": "bash tests/dbt/run.sh"
  },
  "dependencies": {
    "@duckdb/node-api": "1.4.5-r.1",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
