node_modules/
dist/
.venv/
__pycache__/
*.pyc
.snowtest/
.pytest_cache/
*.log
.DS_Store

# Generated by the dbt suite on every run (tests/dbt/run.sh creates the keypair).
tests/dbt/keys/
tests/dbt/target/
tests/dbt/logs/
tests/dbt/.user.yml

# Private keys and local configuration must never be committed.
*.p8
/keys/
.env
.env.*

# SSH keypair used for the repo-scoped deploy key.
/.ssh/

# Local agent instructions, not part of the repo.
/AGENTS.md

# Tooling metadata, never shipped.
/.freebuff/

# Created by podman machine operations under Git Bash on Windows. A file
# named NUL cannot be checked out on Windows, so it must never be tracked.
NUL
